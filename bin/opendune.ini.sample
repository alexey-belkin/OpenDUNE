; copy/rename this sample file to "opendune.ini" in the desired location
; and edit it to suit your preferences.
; Lines starting with a semi-colon ';' are comments
[opendune]
; supported languages are : english, french and german
;language=french
; directory where the Dune 2 data files are :
;datadir=/usr/local/opendune
; directory for save games :
;savedir=/home/user/.config/opendune
; "Zoom" factor (from 1 to 4)
;scalefactor=2
; Rescaling filter availables : nearest (default), scale2x, hqx
;scalefilter=scale2x
; Start OpenDUNE fullscreen if possible (default is 1)
fullscreen=1
; Maximum frame rate  (default is 60)
;framerate=60
; set mt32midi=1 if you output music to a MT-32 device or compatible
; default setting is for GeneralMidi music (Roland SC55)
;mt32midi=1
; Path to MT32 ROMs (needed when built with munt library)
;mt32rompath=/home/user/mt32roms
; FluidSynth settings
fs_soundfont=/usr/local/share/soundfonts/default.sf2
fs_audiodriver=oss
; use the following option to force the Windows MIDI Device ID
midideviceid=0

; Game behaviour options :
;dune2_enhanced=0
;startport_unit_cap=1

; Optional combat-class balance module. Values are integer percentages:
; 100 = x1.00, 250 = x2.50, 30 = x0.30.
class_balance_enabled=1
; Barracks and WOR are both available to every House. The Barracks trains
; Soldier and Infantry, WOR trains Trooper and Troopers. Set to 0 for the
; original per-House availability. The former name of this key,
; class_balance_shared_infantry, is still accepted.
class_balance_infantry_all_houses=1
; Extra firing range in map cells for Soldier and Infantry.
class_range_p_bonus=1
; Light infantry walking speed as a percentage of the matching rocket infantry:
; Soldier from Trooper, Infantry from Troopers. 120 makes the light half a fifth
; faster. 0 switches the rule off and keeps the original factors.
class_speed_p_over_rp=120

; Attacker P (Soldier, Infantry) versus P, RP, LT, TT, AR.
class_damage_p_vs_p=100
class_damage_p_vs_rp=250
class_damage_p_vs_lt=75
class_damage_p_vs_tt=60
class_damage_p_vs_ar=100
; Attacker RP (Trooper, Troopers) versus P, RP, LT, TT, AR.
class_damage_rp_vs_p=30
class_damage_rp_vs_rp=100
class_damage_rp_vs_lt=125
class_damage_rp_vs_tt=130
class_damage_rp_vs_ar=100
; Attacker LT (Trike, Raider Trike, Quad) versus P, RP, LT, TT, AR.
class_damage_lt_vs_p=125
class_damage_lt_vs_rp=135
class_damage_lt_vs_lt=100
class_damage_lt_vs_tt=70
class_damage_lt_vs_ar=250
; Attacker TT (Tank, Siege Tank, Devastator) versus P, RP, LT, TT, AR.
class_damage_tt_vs_p=85
class_damage_tt_vs_rp=90
class_damage_tt_vs_lt=130
class_damage_tt_vs_tt=100
class_damage_tt_vs_ar=100
; Attacker AR (Launcher, Sonic Tank) versus P, RP, LT, TT, AR.
class_damage_ar_vs_p=100
class_damage_ar_vs_rp=100
class_damage_ar_vs_lt=100
class_damage_ar_vs_tt=100
class_damage_ar_vs_ar=100

; Per-unit tuning, as percentages of the table value. Any unit can be named:
; the key is its name lowercased with non-letters turned into underscores, so
; unit_damage_siege_tank, unit_rate_raider_trike, unit_damage_thopter. Damage
; scales the shot before the House bonus and the class matrix, so it reaches
; structures too. Rate scales shots per minute, not the delay between them.
; The Launcher takes its buff on the rate of fire, not on the shot: a shot deals
; a fixed amount and the excess is lost, so more damage per shot buys nothing
; against a target that already died to one. The Sonic Tank has no such
; threshold -- its beam deals hitpoints/4 + 1 per tile -- so it takes damage.
unit_rate_launcher=150
unit_damage_sonic_tank=150
unit_damage_siege_tank=115
unit_damage_devastator=115
unit_rate_raider_trike=120

; House identity bonuses. Quad intentionally does not receive the Ordos bonus.
class_bonus_atreides_p=120
class_bonus_harkonnen_rp=110
class_bonus_ordos_trike=110
; --- Starport ---------------------------------------------------------------
; The Starport is a trader, not a second factory: the goods come from off-world,
; so they cost more than the factory charges and take longer to arrive.
;
; A price is the factory price times (markup/10 - 6 + two dice of 0..6) / 10, so
; starport_markup is the *mean* price as a percentage of the factory price and
; the spread around it is the same either way.  There is no upper cap on a
; price.  60 is the floor: below it the spread would fold over itself.
starport_markup=130
; Ordos are the traders and deal at cost.
starport_markup_ordos=100

; Delivery time, as a percentage of the house table's (10 starport ticks, and a
; starport tick is 3 seconds).  300 makes a delivery take a minute and a half;
; Ordos again get half of that.
starport_delivery=300
starport_delivery_ordos=150

; What the freighter carries.  A type's opening stock is however many of it
; starport_stock_credits buys at the factory price, rounded down and never less
; than one -- 1500 opens the hold with ten Raider Trikes, five Harvesters and a
; single MCV.  Restocking refills a type up to starport_stock_ceiling percent of
; what it opened with.
starport_stock_credits=1500
starport_stock_ceiling=200

; Game ticks between one top-up and the next, at 60 ticks per second.  Each
; top-up adds one to a single randomly chosen type, so lowering this is how you
; make the shelves refill faster.  A type that has sold out comes back; a type
; the freighter never carried stays at zero.
starport_restock_ticks=1800

; Turning on the move.  Arriving on a tile a unit reads the next direction off
; its route and, if it differs from where it is pointing, stops and turns.  On a
; diagonal route that happens every other tile, for 45 degrees each time, which
; is what makes a column move in jerks.  With this on, a 45 degree turn that
; arises while moving is applied at once and the unit drives on in the same
; tick.  Turns from a standstill, and turns of 90 degrees or more, are untouched
; -- a tank still has to come about.
move_rolling_turn=1

; Concrete on sand.  With this off a slab may only be laid on rock, as in the
; original game, so a base can grow no further than the rock the map gave it.
; With it on a slab is also a road: the landscape table already gives concrete a
; movement speed of 255 for every kind of unit against sand's 112, so paving
; costs credits and buys both a foundation to build on and the fastest surface
; in the game to drive on.  Walls are deliberately not included -- a wall has no
; foundation to offer, and letting one go up on open sand would fence off the
; desert.  The "must touch something of your own" rule still applies, so a road
; can only grow outwards from the base, one tile at a time.
build_slab_on_sand=1

; Route finding.  With this off, units use Westwood's original router: it walks
; straight at the destination and, when the next tile is blocked, feels its way
; round the obstacle in both directions for up to a hundred tiles and takes
; whichever went better.  It sees one tile ahead, so units drive into dead ends
; between buildings and grope back out along the wall.  With it on -- the default
; -- the whole route is worked out at once, over the whole map, and it is the
; quickest route rather than merely a route: the cost of a tile is the time the
; unit will really spend crossing it, so concrete is preferred where concrete is
; faster and a diagonal is charged the extra distance it covers.  A unit that is
; itself under way is treated as traffic to be waited out rather than as a wall,
; which keeps a group under one order moving as a group.
pathfinder_astar=1

; The tech tree -- what has to stand before a building may be built.
;
; "stock" is Westwood's tree and the default.  "mp" is the tree this fork plays
; in a match: every early branch hangs off the Refinery instead of the Outpost,
; the Outpost carries the three high-tech buildings, and the Rocket Turret is
; bought with the House of IX instead of with two Construction Yard upgrades.
;
;   building        stock                mp
;   --------        -----                --
;   Windtrap        -                    -
;   Refinery        Windtrap             Windtrap
;   Outpost         Windtrap             Refinery
;   Barracks        Outpost              Refinery
;   WOR             Outpost+Barracks     Refinery+Barracks
;   Wall, Turret    Outpost              Refinery
;   Spice Silo      Refinery             Refinery
;   Light Fctry     Refinery             Refinery
;   Heavy Fctry     Outpost+Light Fctry  Light Fctry
;   Repair          Outpost+Light Fctry  Light Fctry
;   Hi-Tech         Outpost+Light Fctry  Outpost
;   Starport        Refinery             Outpost
;   IX              Refinery+Starport    Outpost
;   R-Turret        Outpost + 2 upgrades IX
;   Palace          Starport             Hi-Tech+IX+Starport
;
; Because the Rocket Turret no longer wants a Construction Yard upgrade, the mp
; tree leaves the Yard with one upgrade instead of two -- the one the large
; concrete slab needs.  The campaign gate is a separate thing and is untouched:
; a match sets it past every building, so in multiplayer this list is the whole
; tech tree, while in the campaign the mission number still has its say.
;
; Both players must be on the same tree.  It is folded into the lobby's room
; name, so a disagreement shows up as "the other player never joined" rather
; than as a desync a minute in.
tech_tree=stock

; Either tree can be edited a line at a time.  tech_req_<building> is the list
; of buildings that must stand first -- "none" for nothing, several separated by
; commas -- and it replaces whatever the named tree said.  The building's name
; is its name lowercased with non-letters turned into underscores; the longer
; spellings in brackets also answer:
;
;   concrete, concrete4 (slab, slab4)     windtrap         refinery
;   const_yard (construction_yard)        outpost (radar)  barracks
;   wor                                   starport         repair
;   light_fctry (light_factory)           wall             turret
;   heavy_fctry (heavy_factory)           palace           ix (house_of_ix)
;   hi_tech (high_tech)                   spice_silo (silo)
;   r_turret (rocket_turret)
;
; tech_upgrade_<building> is the Construction Yard upgrade level the building
; also needs (0 to 3), and tech_upgrade_levels_<building> is how many upgrade
; steps the building itself offers -- it can only take levels away, never invent
; them.
;
;   tech_req_starport=refinery, outpost
;   tech_req_palace=ix
;   tech_upgrade_r_turret=0
;   tech_upgrade_levels_const_yard=1
;
; A tree that cannot be played is refused at start-up and the stock tree is kept:
; that means a cycle (A wants B, B wants A), a building nothing can ever reach,
; or an upgrade level the Construction Yard does not offer.

; The relay the "Play somebody" lobby offers by default.  A relay is a small
; server both players connect to; the two computers never talk directly.
; "host" or "host:port"; the port is 31337 if not given.  Anyone can run one --
; the relay ships beside the game -- and one is enough for both players:
;
;     ./relay -listen 0.0.0.0:31337
;
; Note that any change to the balance keys above changes the digest the lobby
; folds into its room name, so both players need the same settings here or they
; will be put in different rooms and never find each other.
mp_relay=146.103.110.160:31337

; DEBUG options :
;debug_game=1
;debug_scenario=1
;debug_skip_dialogs=1
;debug_log_game=1
